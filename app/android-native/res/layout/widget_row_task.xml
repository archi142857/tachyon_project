<?xml version="1.0" encoding="utf-8"?>
<!-- 할 일 한 줄: 제목 · 마감 말 · 끝내기 동그라미. 줄을 누르면 앱 열기, 동그라미를 누르면 끝내기(TasksWidgetService) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_row_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="@color/widget_text2"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/widget_row_check"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/widget_check"
        android:padding="10dp"
        android:src="@drawable/widget_ic_check" />
</LinearLayout>
